#!/bin/sh
# Installing a build is the user saying "try again", so the boot guard's count of
# unfinished SpringBoard launches is cleared here. Without this, a build that had
# tripped it would stay switched off even after being replaced by a fixed one.

for stale in launchguard paneguard; do
	rm -f "/var/mobile/Library/Preferences/com.recreated.dynamicstage.$stale"
	rm -f "/var/jb/var/mobile/Library/Preferences/com.recreated.dynamicstage.$stale"
	rm -f "/var/tmp/com.recreated.dynamicstage.$stale"
done

rm -rf /var/jb/Library/PreferenceBundles/DynamicStagePrefs.bundle
rm -f /var/jb/Library/PreferenceLoader/Preferences/DynamicStagePrefs.plist
rm -rf /Library/PreferenceBundles/DynamicStagePrefs.bundle

for dir in /var/mobile/Library/Preferences /var/jb/var/mobile/Library/Preferences; do
	if [ -d "$dir" ]; then
		: > "$dir/com.recreated.dynamicstage.installed" || true
	fi
done

# ElleKit loads app tweaks from TweakInject. Theos puts the dylib in
# DynamicLibraries. When TweakInject is a real directory, copy the in-app side
# there. Write the filter as XML text so ElleKit can parse it.
#
# On this device DynamicLibraries has repeatedly lost DynamicStageApp.dylib
# even though the .deb contains it. A second copy lives under Application
# Support and is restored here (and again from SpringBoard on boot).
LIBS="/var/jb/Library/MobileSubstrate/DynamicLibraries"
INJECT="/var/jb/usr/lib/TweakInject"
PAYLOAD="/var/jb/Library/Application Support/DynamicStage"
PLIST_BODY='{
    Filter = {
        Bundles = ( "com.facebook.Messenger" );
        Executables = ( "Messenger" );
    };
}
'
write_plist() {
	dest="$1"
	printf '%s\n' "$PLIST_BODY" > "$dest" || true
}

mkdir -p "$LIBS" || true

if [ ! -f "$LIBS/DynamicStageApp.dylib" ] && [ -f "$PAYLOAD/DynamicStageApp.dylib" ]; then
	cp -f "$PAYLOAD/DynamicStageApp.dylib" "$LIBS/DynamicStageApp.dylib" || true
	if [ -f "$PAYLOAD/DynamicStageApp.plist" ]; then
		cp -f "$PAYLOAD/DynamicStageApp.plist" "$LIBS/DynamicStageApp.plist" || true
	fi
fi

if [ -f "$LIBS/DynamicStageApp.dylib" ]; then
	write_plist "$LIBS/DynamicStageApp.plist"
	if [ -d "$INJECT" ] && [ ! -L "$INJECT" ]; then
		cp -f "$LIBS/DynamicStageApp.dylib" "$INJECT/DynamicStageApp.dylib" || true
		write_plist "$INJECT/DynamicStageApp.plist"
	fi
fi

# Force Messenger to reload the in-app side.
killall -9 Messenger 2>/dev/null || true

exit 0
