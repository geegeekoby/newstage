#!/bin/sh
# Installing a build is the user saying "try again", so the boot guard's count of
# unfinished SpringBoard launches is cleared here. Without this, a build that had
# tripped it would stay switched off even after being replaced by a fixed one.

for stale in launchguard paneguard; do
	rm -f "/var/mobile/Library/Preferences/com.recreated.dynamicstage.$stale"
	rm -f "/var/jb/var/mobile/Library/Preferences/com.recreated.dynamicstage.$stale"
	rm -f "/var/tmp/com.recreated.dynamicstage.$stale"
	rm -f "/var/jb/tmp/com.recreated.dynamicstage.$stale"
	rm -f "/var/jb/var/tmp/com.recreated.dynamicstage.$stale"
done

rm -rf /var/jb/Library/PreferenceBundles/DynamicStagePrefs.bundle
rm -f /var/jb/Library/PreferenceLoader/Preferences/DynamicStagePrefs.plist
rm -rf /Library/PreferenceBundles/DynamicStagePrefs.bundle

for dir in /var/mobile/Library/Preferences /var/jb/var/mobile/Library/Preferences; do
	if [ -d "$dir" ]; then
		: > "$dir/com.recreated.dynamicstage.installed" || true
		# The crash log is about the build being replaced. Leaving it would
		# show that same safe-mode error after the new one is installed.
		rm -f "$dir/com.recreated.dynamicstage.crash.log" || true
		rm -f "$dir/com.recreated.dynamicstage.log" || true
		rm -f "$dir/com.recreated.dynamicstage.keyboard-stage.log" || true
		rm -f "$dir/com.recreated.dynamicstage.keyboard-stage.log.lock" || true
		rm -f "$dir/com.recreated.dynamicstage.log.lock" || true
	fi
done

# ElleKit loads app tweaks from TweakInject. Theos puts the dylib in
# DynamicLibraries. When TweakInject is a real directory, copy the in-app side
# there. The filter is the one the package shipped (Messages, Messenger,
# Signal, Beeper, and Phone). Do not rewrite it: a shorter list left Messages without this dylib,
# so nothing inside a conversation ever changed. An extra Executables entry is
# AND-ed by ElleKit and was skipping the dylib when the process name did not
# match.
#
# On this device DynamicLibraries has repeatedly lost DynamicStageApp.dylib
# even though the .deb contains it. A second copy lives under Application
# Support and is restored here.
LIBS="/var/jb/Library/MobileSubstrate/DynamicLibraries"
INJECT="/var/jb/usr/lib/TweakInject"
PAYLOAD="/var/jb/Library/Application Support/DynamicStage"
mkdir -p /var/jb/tmp || true
rm -f /var/tmp/com.recreated.dynamicstage.ctor /var/tmp/com.recreated.dynamicstage.mapped
rm -f /var/tmp/com.recreated.dynamicstage.beeper-detail.log /var/tmp/com.recreated.dynamicstage.trace.log /var/tmp/com.recreated.dynamicstage.trace.previous.log
rm -f /var/jb/tmp/com.recreated.dynamicstage.beeper-detail.log /var/jb/tmp/com.recreated.dynamicstage.trace.log
rm -f /var/jb/tmp/com.recreated.dynamicstage.ctor /var/jb/tmp/com.recreated.dynamicstage.mapped
mkdir -p "$LIBS" || true

if [ ! -f "$LIBS/DynamicStageApp.dylib" ] && [ -f "$PAYLOAD/DynamicStageApp.dylib" ]; then
	cp -f "$PAYLOAD/DynamicStageApp.dylib" "$LIBS/DynamicStageApp.dylib" || true
fi

FILTER_SRC=""
if [ -f "$PAYLOAD/DynamicStageApp.plist" ]; then
	FILTER_SRC="$PAYLOAD/DynamicStageApp.plist"
elif [ -f "$LIBS/DynamicStageApp.plist" ]; then
	FILTER_SRC="$LIBS/DynamicStageApp.plist"
fi

if [ -f "$LIBS/DynamicStageApp.dylib" ] && [ -n "$FILTER_SRC" ]; then
	cp -f "$FILTER_SRC" "$LIBS/DynamicStageApp.plist" || true
	if [ -d "$INJECT" ] && [ ! -L "$INJECT" ]; then
		cp -f "$LIBS/DynamicStageApp.dylib" "$INJECT/DynamicStageApp.dylib" || true
		cp -f "$FILTER_SRC" "$INJECT/DynamicStageApp.plist" || true
	fi
fi

# Later builds left a daemon behind. This package does not include it.
rm -f "$LIBS/DynamicStageDaemon.dylib" "$LIBS/DynamicStageDaemon.plist" || true
rm -f "$INJECT/DynamicStageDaemon.dylib" "$INJECT/DynamicStageDaemon.plist" || true
rm -f "$INJECT/DynamicStageDaemonApp.dylib" "$INJECT/DynamicStageDaemonApp.plist" || true
rm -f "$PAYLOAD/DynamicStageDaemonApp.dylib" || true

# Do not kill staged apps from here. Killing Beeper while SpringBoard still had
# its scene left respring unable to finish and put the jailbreak in a loop.
# The app dylib is read the next time that app is opened.

exit 0
