#!/bin/sh
# Installing a build is the user saying "try again", so the boot guard's count of
# unfinished SpringBoard launches is cleared here. Without this, a build that had
# tripped the guard would stay disabled even after being replaced by a fixed one.
set -e

rm -f /var/mobile/Library/Preferences/com.recreated.dynamicstage.launchguard
rm -f /var/jb/var/mobile/Library/Preferences/com.recreated.dynamicstage.launchguard

exit 0
