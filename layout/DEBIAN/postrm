#!/bin/sh
# Only the links this package added. A TweakInject that is itself a symlink
# onto MobileSubstrate must not lose the real dylib.
inject=/var/jb/usr/lib/TweakInject
if [ -L "$inject/DynamicStageApp.dylib" ]; then
	rm -f "$inject/DynamicStageApp.dylib"
fi
if [ -L "$inject/DynamicStageApp.plist" ]; then
	rm -f "$inject/DynamicStageApp.plist"
fi
exit 0
